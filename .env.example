# ─────────────────────────────────────────────────────────────────────────────
# SYNAPSE environment (server-side only). Copy to `server/.env` or export in your
# shell. ALL values are optional — SYNAPSE runs fully in demo mode with none set.
# Placeholders only; never commit real secrets. Keys are NEVER exposed to the
# browser.
# ─────────────────────────────────────────────────────────────────────────────

# --- Server ---
PORT=4000
# Interface to bind. Defaults to loopback (127.0.0.1) so an unauthenticated
# instance is not reachable from the network. Set HOST=0.0.0.0 to expose it —
# only together with API_AUTH_TOKEN and CORS_ORIGINS below.
# HOST=127.0.0.1
# Max API requests per IP per minute.
RATE_LIMIT=600
# Max distinct client IPs tracked by the in-memory rate limiter (bounds memory).
# RATE_LIMIT_MAX_CLIENTS=10000
# Where run summaries + workflow defs are persisted (JSON). Defaults to server/data.
# SYNAPSE_DATA_DIR=./server/data

# --- API authentication (opt-in; required before any network exposure) ---
# When set, every /api request except /health must send the token as
# `Authorization: Bearer <token>` or `x-api-key: <token>`. Unset = open mode,
# intended for local development on loopback only.
# API_AUTH_TOKEN=change-me-to-a-long-random-string

# --- CORS (browser cross-origin access) ---
# Comma-separated list of allowed origins. Empty = same-origin only (the bundled
# frontend and the Vite dev proxy work without any cross-origin allowance).
# CORS_ORIGINS=https://synapse.example.com

# --- OpenAI-compatible model adapter (opt-in) ---
# When OPENAI_API_KEY is set, the `openai` adapter becomes available for `llm`
# nodes whose provider.adapter is "openai". Leave unset to stay in demo mode.
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Generic HTTP tool adapter (opt-in) ---
# Comma-separated hostname allowlist. Empty = no outbound hosts permitted.
# Private/loopback/metadata IP ranges are always blocked (SSRF protection).
# TOOL_ALLOWLIST=api.example.com,data.example.org

# --- OpenTelemetry / SigNoz (opt-in) ---
# Setting the OTLP endpoint (or SYNAPSE_OTEL_ENABLED=1) turns on trace + metric
# export. Only safe metadata is exported — never prompt/output bodies or secrets.
# SYNAPSE_OTEL_ENABLED=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=synapse
