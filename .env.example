# ─────────────────────────────────────────────────────────────────────────────
# SYNAPSE environment (server-side only). Copy to `server/.env` or export in your
# shell. ALL values are optional — SYNAPSE runs fully in demo mode with none set.
# Placeholders only; never commit real secrets. Keys are NEVER exposed to the
# browser.
# ─────────────────────────────────────────────────────────────────────────────

# --- Server ---
PORT=4000
# Interface to bind. Defaults to loopback (127.0.0.1) so an unauthenticated
# instance is not reachable from the network. Set HOST=0.0.0.0 to expose it —
# only together with API_AUTH_TOKEN and CORS_ORIGINS below.
# HOST=127.0.0.1
# Max API requests per IP per minute.
RATE_LIMIT=600
# Max distinct client IPs tracked by the in-memory rate limiter (bounds memory).
# RATE_LIMIT_MAX_CLIENTS=10000
# Where run summaries + workflow defs are persisted (JSON). Defaults to server/data.
# SYNAPSE_DATA_DIR=./server/data

# --- API authentication (opt-in; required before any network exposure) ---
# When set, every /api request except /health must send the token as
# `Authorization: Bearer <token>` or `x-api-key: <token>`. Unset = open mode,
# intended for local development on loopback only.
# API_AUTH_TOKEN=change-me-to-a-long-random-string

# --- MCP local stdio client ---
# Local MCP process calls the already-running backend; it does not start another one.
# SYNAPSE_API_BASE_URL=http://127.0.0.1:4000
# SYNAPSE_API_TOKEN=change-me-to-the-same-value-as-API_AUTH_TOKEN

# --- CORS (browser cross-origin access) ---
# Comma-separated list of allowed origins. Empty = same-origin only (the bundled
# frontend and the Vite dev proxy work without any cross-origin allowance).
# CORS_ORIGINS=https://synapse.example.com

# ─────────────────────────────────────────────────────────────────────────────
# LIVE research slice (opt-in). A live research run needs BOTH a search provider
# AND a model provider. With neither, SYNAPSE stays in demo mode. SYNAPSE never
# silently falls back from a requested live provider to demo output.
# ─────────────────────────────────────────────────────────────────────────────

# --- Live search / retrieval adapter (opt-in) ---
# Pick ONE provider and set its key. The `search` adapter handles retrieval nodes
# whose provider.adapter is "search". Content comes from the provider's own
# extract field (no arbitrary page fetching here).
# SEARCH_PROVIDER=tavily            # tavily | brave | serpapi
# TAVILY_API_KEY=tvly-your-key-here
# TAVILY_BASE_URL=https://api.tavily.com
# BRAVE_API_KEY=your-brave-key
# BRAVE_BASE_URL=https://api.search.brave.com
# SERPAPI_API_KEY=your-serpapi-key
# SERPAPI_BASE_URL=https://serpapi.com

# --- Which model the built-in "Research Brief (Live)" workflow uses ---
# Chosen at server start; point it at whichever provider you have a key for.
# SYNAPSE_LIVE_MODEL_ADAPTER=anthropic   # anthropic | openai | gemini
# SYNAPSE_LIVE_MODEL=claude-3-5-haiku-latest

# --- OpenAI (or OpenAI-compatible) model adapter (opt-in) ---
# When OPENAI_API_KEY is set, the `openai` adapter becomes available for `llm`
# nodes whose provider.adapter is "openai". Leave unset to stay in demo mode.
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (Claude) model adapter (opt-in) ---
# Enables the `anthropic` adapter for llm nodes. NOTE: an MCP connection to a
# Claude host does NOT supply these credentials — this is a separate API key.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Google Gemini model adapter (opt-in) ---
# Enables the `gemini` adapter for llm nodes. GOOGLE_API_KEY is accepted as an alias.
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_MODEL=gemini-2.0-flash

# --- Generic HTTP tool adapter (opt-in) ---
# Comma-separated hostname allowlist. Empty = no outbound hosts permitted.
# Private/loopback/metadata IP ranges are always blocked (SSRF protection).
# TOOL_ALLOWLIST=api.example.com,data.example.org

# --- OpenTelemetry / SigNoz (opt-in) ---
# Setting the OTLP endpoint (or SYNAPSE_OTEL_ENABLED=1) turns on trace + metric
# export. Only safe metadata is exported — never prompt/output bodies or secrets.
# SYNAPSE_OTEL_ENABLED=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=synapse
